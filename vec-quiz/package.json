{
  "name": "vec-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "VEC multilingual quiz playable engine by Gamify. Vanilla HTML, CSS and JS at runtime; Node for tooling only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:release": "node tools/build.mjs --release",
    "dev": "node tools/serve.mjs --watch",
    "preview": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "sheet2json": "node tools/sheet2json.mjs",
    "fonts": "node tools/fonts.mjs",
    "zip": "node tools/zip-guard.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "qa": "node tools/qa.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fontverter": "2.0.0",
    "playwright-core": "1.56.1",
    "subset-font": "2.9.0"
  }
}
