{
  "name": "night-contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Night Contracts: open-city superbike action game (mobile first, web + Capacitor).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cap:sync": "pnpm build && cap sync",
    "build:artifact": "vite build --mode artifact && node tools/make-artifact.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "howler": "^2.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
